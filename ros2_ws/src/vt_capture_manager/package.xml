<?xml version="1.0"?>
<package format="3">
  <name>vt_capture_manager</name><version>0.6.0</version>
  <description>ROS capture observability, local snapshots, and opt-in durable recorder management.</description>
  <maintainer email="vision-tactile@example.com">Vision Tactile Team</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend><depend>sensor_msgs</depend><depend>vt_tracker_msgs</depend>
  <depend>vt_glove_msgs</depend><depend>vt_tactile_msgs</depend><depend>vt_camera_msgs</depend>
  <exec_depend>realsense2_camera_msgs</exec_depend>
  <exec_depend version_gte="0.6.0">vt_capture_core</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend><exec_depend>python3-numpy</exec_depend>
  <!-- Dynamic message lookup in the post-record quality worker. -->
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>vt_realsense_capture</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
