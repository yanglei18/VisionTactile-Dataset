# Display-only D436 workspace: no camera driver, filters, or recording control.
# Grid and axes are camera-relative references, not a calibrated world frame.
Panels:
  - Class: rviz_common/Displays
    Help Height: 60
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /D436 Color Point Cloud1
      Splitter Ratio: 0.5
    Tree Height: 450
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 0.25
      Class: rviz_default_plugins/Grid
      Color: 95; 114; 136
      Enabled: true
      Line Style:
        Line Width: 0.01
        Value: Lines
      Name: Camera Reference Grid (0.25 m)
      Normal Cell Count: 0
      Offset:
        X: 1
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.25
      Name: Camera Axes (XYZ)
      Radius: 0.006
      Reference Frame: d436_link
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        d436_link:
          Value: true
        d436_depth_frame:
          Value: true
        d436_depth_optical_frame:
          Value: true
        d436_color_frame:
          Value: true
        d436_color_optical_frame:
          Value: true
      Marker Scale: 0.3
      Name: D436 Coordinate Frames
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0.1
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: D436 Color Point Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.003
      Style: Flat Squares
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /d436/depth/color/points
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RGB Image
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /d436/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Depth Image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /d436/depth/image_rect_raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 25; 34
    Fixed Frame: d436_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 92; 213; 220
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.8
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785398
      Focal Point:
        X: 1.4
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.03
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.18
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.141593
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  RGB Image:
    collapsed: false
  Depth Image:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  # Qt dock state: Displays/Views left, RGB/Depth stacked right, 3D center.
  QMainWindow State: 
  Width: 1440
  X: 70
  Y: 50
