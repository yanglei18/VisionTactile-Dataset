<?xml version="1.0"?>
<package format="3">
  <name>vt_vive_tracker</name>
  <version>0.2.0</version>
  <description>Read-only ROS 2 publisher for three VIVE Ultimate Trackers.</description>
  <maintainer email="vision-tactile@example.com">Vision Tactile Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>vt_tracker_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
